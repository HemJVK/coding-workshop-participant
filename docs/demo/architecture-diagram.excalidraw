      "isDeleted": false,
      "boundElements": null,
      "updated": 1776389001000,
      "link": null,
      "locked": false,
      "text": "Legend\nCircle/Ellipse: actor or platform boundary\nDiamond: decision points (Auth/RBAC, analytics logic)\nRounded rectangle: service or system component\nCylindrical group: persistent data store\nSolid arrows: request flow | Dashed arrows: data dependency/joins",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 89,
      "containerId": null,
      "originalText": "Legend\nCircle/Ellipse: actor or platform boundary\nDiamond: decision points (Auth/RBAC, analytics logic)\nRounded rectangle: service or system component\nCylindrical group: persistent data store\nSolid arrows: request flow | Dashed arrows: data dependency/joins",
      "lineHeight": 1.25
    },
