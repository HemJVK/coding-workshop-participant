      "isDeleted": false,
      "boundElements": null,
      "updated": 1776389001000,
      "link": null,
      "locked": false,
      "text": "Key Edge Cases and Hardening Notes\n1) Gateway path normalization for ID routes across services\n2) Replace default JWT/DB secrets with managed secret stores\n3) Align soft-delete/hard-delete policy across domains\n4) Expand automated tests to goals/reviews/training/development/competencies\n5) Keep manager scope checks consistent on every write path",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 89,
      "containerId": null,
      "originalText": "Key Edge Cases and Hardening Notes\n1) Gateway path normalization for ID routes across services\n2) Replace default JWT/DB secrets with managed secret stores\n3) Align soft-delete/hard-delete policy across domains\n4) Expand automated tests to goals/reviews/training/development/competencies\n5) Keep manager scope checks consistent on every write path",
      "lineHeight": 1.25
    },
